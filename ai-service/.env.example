# Copy to ai-service/.env. Never commit the real .env.
PORT=5000

# 127.0.0.1 keeps the service local; set 0.0.0.0 only when it must be reachable from other hosts
HOST=127.0.0.1

# Never enable in production (the Flask debugger allows code execution)
DEBUG=False

# Shared secret required in the X-Service-Token header for /api/train and /api/recommend
# (both return 503 while this is empty). Must equal AI_SERVICE_TOKEN in backend/.env.
AI_SERVICE_TOKEN=replace-with-a-long-random-string

# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
