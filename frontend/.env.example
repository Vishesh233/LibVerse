# Copy to frontend/.env. In production, set this to the deployed backend URL (ending in /api).
VITE_API_BASE_URL=http://localhost:5001/api

# Sign in with Google (production site only): the same OAuth client ID as GOOGLE_CLIENT_ID on the API.
# Leave it unset on the live demo site and wherever Google sign-in is not wanted.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# Live demo site only: this build is the demo (role buttons only, never the password form, even
# while the demo API is still waking up). Leave unset on the full app.
# VITE_DEMO_MODE=true
# Live demo site only: the full app's address; "Sign in / Create your own account" goes to its /login
# VITE_FULL_APP_URL=https://libverse.vercel.app

# Full app only: the live demo site's address; /demo on the full app redirects there
# VITE_DEMO_APP_URL=https://libverse-demo.vercel.app
