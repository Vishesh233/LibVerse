# Copy to backend/.env and fill in real values. Never commit the real .env.

# MongoDB connection string (local example; use your own host/database)
MONGODB_URI=mongodb://127.0.0.1:27017/libraryDB

# Required: long random string used to sign login tokens (the server refuses to start without it)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=30d

PORT=5001

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Automatic due-soon / overdue reminder notifications (hourly check, at most one run per day). Set to false to disable.
REMINDERS_ENABLED=true

# AI recommendation service (ai-service). Both must be set to use it; otherwise "Picked for you"
# uses the MongoDB genre fallback. AI_SERVICE_TOKEN must equal AI_SERVICE_TOKEN in ai-service/.env.
AI_SERVICE_URL=http://127.0.0.1:5000
AI_SERVICE_TOKEN=change-me-to-a-long-random-string

NODE_ENV=development

# Behind a reverse proxy (Render, Nginx): number of proxy hops, so rate limits see the real client IP
# TRUST_PROXY=1

# Content-Security-Policy: origin(s) the frontend loads the API and /uploads from (default http://localhost:PORT)
# CSP_API_ORIGINS=https://libverse-api.onrender.com

# Outgoing email for "Forgot password" (a 6-digit code by email). Set ALL five to turn it on;
# otherwise the login page says "Ask your librarian or admin". Port 465 uses TLS, 587 STARTTLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-username
# SMTP_PASS=app-password-or-api-key
# MAIL_FROM="LibVerse <no-reply@example.com>"

# Rate limits per client IP (defaults: login 10 failed / 15 min, signup 10 / hour, password change 5 / 15 min,
# forgot-password emails 5 / 15 min, reset code entries 10 / 15 min)
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_SIGNUP=10
# RATE_LIMIT_PASSWORD_CHANGE=5
# RATE_LIMIT_FORGOT_PASSWORD=5
# RATE_LIMIT_RESET_PASSWORD=10

# Live demo instance only (a separate deployment with its own libverse_demo database; DEPLOYMENT.md):
# true = the login page shows only "Try as Student / Librarian / Admin" (POST /api/auth/demo-login);
# password login, signup and password reset are off. Demo sessions last DEMO_JWT_EXPIRE (default 2h).
# Each demo account may make RATE_LIMIT_DEMO_WRITES changes per 15 min (default 60); the demo
# buttons allow RATE_LIMIT_DEMO_LOGIN sign-ins per IP per 15 min (default 30).
# DEMO_MODE=true
# DEMO_JWT_EXPIRE=2h
# RATE_LIMIT_DEMO_WRITES=60
# RATE_LIMIT_DEMO_LOGIN=30

# Demo scripts only (seedDemo.js, resetDemo.js): the demo database, never the production one
# DEMO_MONGODB_URI=mongodb://127.0.0.1:27017/libverse_demo

# Tests only (npm test): a throwaway database whose name ends in _test. It is emptied on every run.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/libverse_jest_test
