# Copy to backend/.env and fill in real values. Never commit the real .env.

# MongoDB connection string (local example; use your own host/database)
MONGODB_URI=mongodb://127.0.0.1:27017/libraryDB

# Required: long random string used to sign login tokens (the server refuses to start without it)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=30d

PORT=5001

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI recommendation service (ai-service)
AI_SERVICE_URL=http://127.0.0.1:5000

NODE_ENV=development
